<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Vedito"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vedito"
        android:usesCleartextTraffic="false">

        <service
            android:name=".feature.export.ExportForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing"
            android:stopWithTask="false" />

        <activity
            android:name=".feature.editor.EditorActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".feature.home.HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
