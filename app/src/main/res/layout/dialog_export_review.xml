<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bg_export_sheet" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Ready to export?" android:textSize="21sp" android:fontFamily="sans-serif-medium"
            android:textColor="@color/vedito_text"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="Check the output and device readiness before saving your video."
            android:textSize="12sp" android:textColor="@color/vedito_muted"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="17dp" android:orientation="vertical" android:background="@drawable/bg_export_card"
            android:padding="15dp">
            <TextView android:id="@+id/exportReviewProfile" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="15sp" android:fontFamily="sans-serif-medium"
                android:textColor="@color/vedito_text"/>
            <TextView android:id="@+id/exportReviewDetails" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textSize="12sp"
                android:textColor="@color/vedito_text_secondary"/>
            <TextView android:id="@+id/exportReviewBudget" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="9dp" android:textSize="12sp"
                android:textColor="@color/vedito_brand_cyan"/>
        </LinearLayout>
        <TextView android:id="@+id/exportReviewStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textSize="13sp"
            android:fontFamily="sans-serif-medium" android:textColor="@color/vedito_success"/>
        <TextView android:id="@+id/exportReviewNotes" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="12sp"
            android:textColor="@color/vedito_text_secondary"/>
        <TextView android:id="@+id/exportReviewSave" android:layout_width="match_parent"
            android:layout_height="52dp" android:layout_marginTop="18dp" android:gravity="center"
            android:background="@drawable/bg_primary_button" android:fontFamily="sans-serif-medium"
            android:text="Save MP4" android:textSize="15sp" android:textColor="@color/vedito_white"
            android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/exportReviewBack" android:layout_width="match_parent"
            android:layout_height="46dp" android:layout_marginTop="8dp" android:gravity="center"
            android:background="@drawable/bg_export_secondary" android:text="Change settings"
            android:textSize="13sp" android:textColor="@color/vedito_text_secondary"
            android:clickable="true" android:focusable="true"/>
    </LinearLayout>
</ScrollView>
