<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/editorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vedito_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="14dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="Back"
            android:padding="12dp"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/projectTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/vedito_text"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:includeFontPadding="false"
                android:text="Draft · autosaved"
                android:textColor="@color/vedito_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="9dp"
            android:paddingTop="6dp"
            android:paddingEnd="9dp"
            android:paddingBottom="6dp"
            android:text="EDIT"
            android:textColor="@color/vedito_accent"
            android:textSize="10sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_weight="0.95"
        android:background="@color/vedito_surface">

        <FrameLayout
            android:id="@+id/canvasSurface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:background="@color/vedito_black">

            <TextureView
                android:id="@+id/previewTexture"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <FrameLayout
                android:id="@+id/overlayPreviewLayer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="true"
                android:clipToPadding="true" />

            <FrameLayout
                android:id="@+id/textPreviewLayer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="true"
                android:clipToPadding="true" />
        </FrameLayout>

        <TextView
            android:id="@+id/playerError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:textColor="@color/vedito_muted"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <ScrollView
        android:id="@+id/editorControlsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.25"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/currentTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="00:00.0"
                android:textColor="@color/vedito_muted"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/playPauseButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_transport"
                android:contentDescription="Play"
                android:padding="12dp"
                android:src="@drawable/ic_play" />

            <TextView
                android:id="@+id/totalTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:gravity="end"
                android:text="00:00.0"
                android:textColor="@color/vedito_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/selectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="sans-serif-medium"
            android:text="Clip 1"
            android:textColor="@color/vedito_text"
            android:textSize="12sp" />

        <com.vedito.app.feature.editor.visual.TransformToolbarView
            android:id="@+id/visualToolbar"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="4dp"
            android:contentDescription="Visual transform controls" />

        <com.vedito.app.feature.editor.timing.TimingToolbarView
            android:id="@+id/timingToolbar"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="2dp"
            android:contentDescription="Speed, freeze and reverse controls" />

        <TextView
            android:id="@+id/overlaySelectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif-medium"
            android:text="No overlay · add image or video PIP"
            android:textColor="@color/vedito_muted"
            android:textSize="10sp" />

        <com.vedito.app.feature.editor.overlay.OverlayTimelineView
            android:id="@+id/overlayTimeline"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="3dp"
            android:contentDescription="Visual overlay timeline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/addOverlayButton"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1.3"
                android:background="@drawable/bg_tool_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Add overlay"
                android:textColor="@color/vedito_text"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/overlayBackButton"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tool_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Layer −"
                android:textColor="@color/vedito_text"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/overlayFrontButton"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tool_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Layer +"
                android:textColor="@color/vedito_text"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/overlayDeleteButton"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tool_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Delete"
                android:textColor="@color/vedito_text"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/textSelectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:text="No text · add a title or caption"
            android:textColor="@color/vedito_muted"
            android:textSize="10sp" />

        <com.vedito.app.feature.editor.text.TextToolbarView
            android:id="@+id/textToolbar"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="2dp"
            android:contentDescription="Text transform and style controls" />

        <com.vedito.app.feature.editor.text.TextTimelineView
            android:id="@+id/textTimeline"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="2dp"
            android:contentDescription="Text timeline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/addTextButton"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1.15"
                android:background="@drawable/bg_tool_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Add text"
                android:textColor="@color/vedito_text"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/editTextButton"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tool_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Edit"
                android:textColor="@color/vedito_text"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/textBackButton"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tool_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Layer −"
                android:textColor="@color/vedito_text"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/textFrontButton"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tool_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Layer +"
                android:textColor="@color/vedito_text"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/textDeleteButton"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tool_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Delete"
                android:textColor="@color/vedito_text"
                android:textSize="9sp" />
        </LinearLayout>

        <com.vedito.app.feature.editor.timeline.TimelineScrubberView
            android:id="@+id/timeline"
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:layout_marginTop="5dp"
            android:contentDescription="Video timeline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Scrub · snap to edges · pinch timeline to zoom · hold clip to reorder"
            android:textColor="@color/vedito_muted"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/zoomLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="1.0×"
                android:textColor="@color/vedito_accent"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Frame-snapped timeline"
                android:textColor="@color/vedito_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/audioSelectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="sans-serif-medium"
            android:text="No audio · add music or sound"
            android:textColor="@color/vedito_muted"
            android:textSize="10sp" />

        <com.vedito.app.feature.editor.audio.AudioTimelineView
            android:id="@+id/audioTimeline"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="4dp"
            android:contentDescription="Audio timeline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Audio: drag to move · drag edges to trim · clips snap to edit points"
            android:textColor="@color/vedito_muted"
            android:textSize="9sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/addAudioButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1.25"
                android:background="@drawable/bg_tool_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Add audio"
                android:textColor="@color/vedito_text"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/audioVolumeDownButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="0.8"
                android:background="@drawable/bg_tool_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Vol −"
                android:textColor="@color/vedito_text"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/audioVolumeUpButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="0.8"
                android:background="@drawable/bg_tool_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Vol +"
                android:textColor="@color/vedito_text"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/audioMuteButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="0.9"
                android:background="@drawable/bg_tool_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Mute"
                android:textColor="@color/vedito_text"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/audioDeleteButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="2dp"
                android:layout_weight="0.9"
                android:background="@drawable/bg_tool_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Delete"
                android:textColor="@color/vedito_text"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/audioSplitButton"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tool_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Audio split"
                android:textColor="@color/vedito_text"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/audioFadeInButton"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tool_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Fade in"
                android:textColor="@color/vedito_text"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/audioFadeOutButton"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tool_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Fade out"
                android:textColor="@color/vedito_text"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/extractAudioButton"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tool_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Extract"
                android:textColor="@color/vedito_text"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/addClipButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tool_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Add video"
                android:textColor="@color/vedito_text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/splitButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tool_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Split"
                android:textColor="@color/vedito_text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/deleteButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tool_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Delete"
                android:textColor="@color/vedito_text"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/undoButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tool_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Undo"
                android:textColor="@color/vedito_text"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/redoButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tool_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Redo"
                android:textColor="@color/vedito_text"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/duplicateButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tool_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Duplicate"
                android:textColor="@color/vedito_text"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/replaceButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tool_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Replace"
                android:textColor="@color/vedito_text"
                android:textSize="10sp" />
        </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
