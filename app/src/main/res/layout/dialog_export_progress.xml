<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bg_export_sheet" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp" android:gravity="center_horizontal">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Exporting video" android:textColor="@color/vedito_text" android:textSize="21sp"
            android:fontFamily="sans-serif-medium"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:text="Your project keeps rendering in the background."
            android:textColor="@color/vedito_muted" android:textSize="12sp"/>
        <FrameLayout android:layout_width="146dp" android:layout_height="146dp" android:layout_marginTop="16dp">
            <com.vedito.app.feature.export.ui.ExportProgressRingView android:id="@+id/exportProgressRing"
                android:layout_width="match_parent" android:layout_height="match_parent"/>
            <TextView android:id="@+id/exportProgressPercent" android:layout_width="match_parent"
                android:layout_height="match_parent" android:gravity="center" android:text="0%"
                android:textSize="27sp" android:fontFamily="sans-serif-medium" android:textColor="@color/vedito_text"/>
        </FrameLayout>
        <TextView android:id="@+id/exportProgressStage" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center"
            android:text="Preparing export" android:textSize="14sp" android:fontFamily="sans-serif-medium"
            android:textColor="@color/vedito_text"/>
        <TextView android:id="@+id/exportProgressElapsed" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center"
            android:text="Elapsed time will appear here" android:textSize="12sp" android:textColor="@color/vedito_muted"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:background="@drawable/bg_export_card" android:padding="13dp"
            android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="FOREGROUND EXPORT" android:letterSpacing="0.1" android:textSize="10sp"
                android:textColor="@color/vedito_brand_cyan"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="You can leave the editor or turn off the screen. Progress remains available in the notification."
                android:textSize="12sp" android:textColor="@color/vedito_text_secondary"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/exportProgressCancel" android:layout_width="0dp"
                android:layout_height="50dp" android:layout_weight="1" android:layout_marginEnd="5dp"
                android:background="@drawable/bg_export_secondary" android:gravity="center"
                android:text="Cancel" android:textSize="13sp" android:textColor="@color/vedito_text_secondary"
                android:clickable="true" android:focusable="true"/>
            <TextView android:id="@+id/exportProgressBackground" android:layout_width="0dp"
                android:layout_height="50dp" android:layout_weight="1.5" android:layout_marginStart="5dp"
                android:background="@drawable/bg_primary_button" android:gravity="center"
                android:text="Run in background" android:textSize="13sp" android:fontFamily="sans-serif-medium"
                android:textColor="@color/vedito_white" android:clickable="true" android:focusable="true"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
